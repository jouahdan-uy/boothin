# URL frontend (Vercel). Dipakai untuk link QR / email dan whitelist CORS.
APP_URL=http://localhost:5173
# Origin tambahan yang boleh memanggil API, pisahkan dengan koma (opsional)
CORS_ORIGINS=

PORT=3000

# Berapa lama foto sementara disimpan (menit). Default 360 = 6 jam.
SESSION_TTL_MINUTES=360
MAX_UPLOAD_MB=8
MAX_SESSIONS=500

# Storage: "memory" (default untuk dev) atau "cloudinary".
# Kalau 3 variabel Cloudinary diisi, otomatis pakai cloudinary.
STORAGE_DRIVER=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (https://resend.com). Kosong = endpoint /api/email membalas 503.
RESEND_API_KEY=
MAIL_FROM=Boothin' <onboarding@resend.dev>

# Tujuan pesan dari form Contact & Feedback (butuh RESEND_API_KEY juga).
# Isi di .env lokal dan di Railway Variables, jangan di-commit ke repo.
OWNER_EMAIL=
